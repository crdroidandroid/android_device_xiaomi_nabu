# Allow hal_bluetooth_default to read files in vendor_wifi_vendor_data_file
allow hal_bluetooth_default vendor_diag_device:chr_file rw_file_perms;
r_dir_file(hal_bluetooth_default, vendor_wifi_vendor_data_file)

# Allow hal_bluetooth_default to read the bluetooth firmware ramdump directory
allow hal_bluetooth_default vendor_ramdump_vendor_data_file:dir r_dir_perms;
allow hal_bluetooth_default vendor_ramdump_vendor_data_file:file r_file_perms;
